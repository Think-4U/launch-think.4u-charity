# Flask core
SECRET_KEY=change-me-to-a-very-long-random-secret-min-32-chars
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Admin credentials
# Generate the password hash using: python scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_OUTPUT_OF_hash_password_script

# Session security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
